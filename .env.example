# ค่าลับของ /opt/promotion_dashboard — ห้าม commit (อยู่ใน .gitignore), chmod 600
# โหลดโดย gh_env.py ; ค่าใน environment ของ process ชนะค่าในไฟล์นี้

# MySQL gh_promotion
GH_MYSQL_HOST=10.8.1.88
GH_MYSQL_PORT=3306
GH_MYSQL_DB=gh_promotion
# root: app.py (Streamlit 83), etl/etl_app.py (89), etl/etl_sync.py
GH_MYSQL_ROOT_USER=root
GH_MYSQL_ROOT_PASSWORD=CHANGE-ME
# admin: greyhound_bi_api.py (9007), etl/sale_monitor_etl.py
GH_MYSQL_ADMIN_USER=admin
GH_MYSQL_ADMIN_PASSWORD=CHANGE-ME

# CM POS (MSSQL) ของ Greyhound
GH_MSSQL_HOST=192.168.5.3
GH_MSSQL_PORT=1433
GH_MSSQL_DB=GH
GH_MSSQL_USER=cmpos01
GH_MSSQL_PASSWORD=CHANGE-ME

# API keys
BI_API_KEY=CHANGE-ME
SALE_MONITOR_API_KEY=CHANGE-ME

# login หน้า ETL Admin (พอร์ต 89) — user:password คั่นด้วย ,
ETL_ADMIN_USERS=CHANGE-ME

# เซ็น cookie จำ login หน้า Streamlit 83
DASH_SESSION_SECRET=CHANGE-ME
